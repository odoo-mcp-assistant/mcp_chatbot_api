# FastAPI service
API_HOST=0.0.0.0
API_PORT=8020
LOG_LEVEL=info

# CORS — origin(s) from which the widget will call this API
# Comma-separated list. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:8069

# Odoo connection (odoorpc uses Odoo's JSON-RPC endpoint on port 8069)
ODOO_HOST=localhost
ODOO_PORT=8069
ODOO_DB=your_db_name
ODOO_USER=admin@example.com
ODOO_PASSWORD=changeme

# JWT — shared secret between Odoo (issuer) and FastAPI (verifier).
# Must match the value stored in Odoo's ir.config_parameter under
# the key `mcp_chatbot.jwt_secret`. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_AUDIENCE=mcp-chatbot-api

# Request timeout for the agentic loop (seconds).
REQUEST_TIMEOUT=118
